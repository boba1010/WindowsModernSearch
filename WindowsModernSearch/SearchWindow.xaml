<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsModernSearch.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsModernSearch"
    Title="WindowsModernSearch">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel 
            Background="{ThemeResource CardStrokeColorDefaultSolid}" 
            Padding="15" Spacing="10" 
            CornerRadius="15" Grid.Row="1">
            <TextBox 
                Background="Transparent"
                BorderBrush="Transparent"
                x:Name="SearchBox" 
                PlaceholderText="Search..."
                Height="50"
                HorizontalAlignment="Stretch" 
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

                    <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="Transparent"/>
                </TextBox.Resources>
            </TextBox>

            <Button CornerRadius="14" Content="Open" HorizontalAlignment="Right" Background="{ThemeResource SystemAccentColor}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="LightGray"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark1}"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}"/>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
